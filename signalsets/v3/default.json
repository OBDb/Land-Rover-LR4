"synthetics": [
  { "id": "LR4_FUEL_RATE", "path": "Fuel", "name": "Fuel Rate", "max": 32, "unit": "gallonsPerHour", "suggestedMetric": "fuelRate", "formula": {
    "op": "ratio", "a": "LR4_MAF", "b": "LR4_FUEL_DIVISOR"
  }},
  { "id": "LR4_FUEL_RATE_GPM", "path": "Fuel", "name": "Fuel Rate (gal/min)", "max": 0.6, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_MAF", "b": "LR4_FUEL_DIVISOR_MIN"
  }},
  { "id": "LR4_MPG", "path": "Fuel", "name": "Fuel Economy (mpg)", "max": 200, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_MPG_NUMERATOR", "b": "LR4_MAF"
  }},
  { "id": "LR4_GAL_PER_100MI", "path": "Fuel", "name": "Fuel Use (gal/100 mi)", "max": 100, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_MAF", "b": "LR4_GP100_DENOMINATOR"
  }},
  { "id": "LR4_MPG_LAMBDA", "path": "Fuel", "name": "Fuel Economy (mpg, lambda-corrected, test)", "max": 200, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_SPEED_MPH", "b": "LR4_FUEL_RATE"
  }},
  { "id": "LR4_BANK_BALANCE", "path": "Engine", "name": "Bank Balance", "max": 3, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_CAT_TEMP_B1", "b": "LR4_CAT_TEMP_B2"
  }},
  { "id": "LR4_BOOST_RATIO", "path": "Engine", "name": "Boost Pressure Ratio", "max": 3, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_MAP", "b": "LR4_BARO"
  }},
  { "id": "LR4_LAMBDA_TRACKING", "path": "Engine", "name": "Lambda Tracking", "max": 3, "unit": "scalar", "formula": {
    "op": "ratio", "a": "LR4_O2_LAMBDA", "b": "LR4_EQ_RATIO"
  }},
  { "id": "LR4_PEDAL_AGREEMENT", "path": "Engine", "name": "Pedal Agreement", "max": 3, "unit": "scalar", "formula": {
