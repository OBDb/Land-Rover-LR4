{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F40D"}, "freq": 2,
  "signals": [
    {"id": "LR4_SPEED", "path": "Movement", "fmt": { "len": 8, "max": 255, "unit": "kilometersPerHour" }, "name": "Vehicle Speed", "suggestedMetric": "speed"},
    {"id": "LR4_SPEED_MPH", "hidden": true, "path": "Movement", "fmt": { "len": 8, "max": 158.4, "mul": 0.621371, "unit": "milesPerHour" }, "name": "Vehicle Speed (mph operand)", "description": "Speed in mph as a synthetic operand. Divided by the gal/h fuel rate it gives lambda-corrected mpg, if the app lets a synthetic read another synthetic. That is untested; see Fuel Economy (lambda-corrected, test)."},
    {"id": "LR4_MPG_NUMERATOR", "hidden": true, "path": "Movement", "fmt": { "len": 8, "max": 1824.6, "mul": 7.15535, "unit": "scalar" }, "name": "Fuel Economy Numerator", "description": "Speed in mph premultiplied by 14.7 x 745 / 3600 x 3.785, so that dividing it by mass air flow gives mpg at lambda 1. The synthetic ratio has room for only two operands, so commanded lambda is assumed stoichiometric. Closed-loop cruise is; enrichment and fuel cut are not."},
    {"id": "LR4_GP100_DENOMINATOR", "hidden": true, "path": "Movement", "fmt": { "len": 8, "max": 18.25, "mul": 0.0715535, "unit": "scalar" }, "name": "Gallons per 100 Miles Denominator", "description": "Speed in mph times 14.7 x 745 / 3600 x 3.785 / 100, so that mass air flow divided by it gives US gallons per 100 miles at lambda 1."}
  ]},
