{ "hdr": "726", "rax": "72E", "cmd": {"22": "0202"}, "freq": 600,
  "signals": [
    {"id": "LR4_726_0202_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "726 0202 Raw", "description": "The only non-identification DID ever found on module 726, from a sweep of 0000-03FF. Has only ever returned 00."}
  ]},
{ "hdr": "7E1", "rax": "7E9", "cmd": {"22": "1E6A"}, "freq": 600,
  "signals": [
