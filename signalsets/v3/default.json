{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F434"}, "freq": 15,
  "signals": [
    {"id": "LR4_O2_LAMBDA",  "path": "Engine", "fmt": {           "len": 16, "max": 2,     "div": 32768, "nullmin": 0, "unit": "scalar" }, "name": "O2 Lambda B1S1",    "suggestedMetric": "o2Lambda"},
    {"id": "LR4_O2_CURRENT", "path": "Engine", "fmt": {"bix": 16, "len": 16, "max": 128, "min": -128, "div": 256, "add": -128, "unit": "milliamps"  }, "name": "O2 Pump Current B1S1", "description": "The second word of SAE J1979 PID 34 is sensor current, not voltage; the voltage variants are PIDs 24 to 2B, which this ECM does not support. Read as voltage it sat at a meaningless flat 4.0 across 28,432 samples. Read as current it spans -0.95 to +1.36 mA with a mean of +0.16, which is what a wideband pump cell should do."}
  ]},
