  ]},
{ "hdr": "792", "rax": "79A", "cmd": {"22": "2A3C"}, "freq": 600,
  "signals": [
    {"id": "LR4_2A3C_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 24, "max": 16777215, "unit": "scalar" }, "name": "2A3C Raw"}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B00"}, "freq": 120,
  "signals": [
    {"id": "LR4_3B00_RAW", "hidden": true, "path": "Suspension", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "3B00 Raw", "description": "Undecoded. Reads 0x03 in 111 of 113 samples; the exception is 0x103, once, with the truck sitting at Access. Bit 8 looks like a height-event flag, and 3B02 carries a bit-8 flag that behaves the same way."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B08"}, "freq": 120,
  "signals": [
    {"id": "LR4_3B08_RAW", "hidden": true, "path": "Suspension", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "3B08 Raw", "description": "Undecoded. Reads 0x00 in 130 of 131 samples; the exception is 0x01, once, with Off-Road engaged and the truck at its highest. One sample is not a decode, but it is not dead either."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B4D"}, "freq": 30,
  "signals": [
    {"id": "LR4_3B4D_RAW", "hidden": true, "path": "Suspension", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "3B4D Raw", "description": "Terrain Response candidate, and back in contention. It held a constant 0x00 across 236 samples and was written off as dead; the first short drive on which the off-road features were deliberately exercised produced 0x04, 0x01 and 0x00 within eight minutes. It does not track the ride height mode PID, so it is reporting something else. Needs one sample per selectable terrain mode to map."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F458"}, "freq": 120,
  "signals": [
    {"id": "LR4_SEC_O2_TRIM_B2", "path": "Fuel", "fmt": { "len": 8, "max": 99.2, "min": -100, "mul": 100, "div": 128, "add": -100, "unit": "percent" }, "name": "Long Term Secondary O2 Trim B2", "description": "SAE J1979 PID 58, the bank 2 counterpart to PID 56. Previously carried as an undecoded raw byte and briefly deleted on the mistaken reading that its single logged reply was a negative response; 62F458 7F is a positive reply meaning -0.78%."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F423"}, "freq": 60,
  "signals": [
    {"id": "LR4_FUEL_RAIL_GAUGE_P", "path": "Fuel", "fmt": { "len": 16, "max": 655350, "mul": 10, "unit": "kilopascal" }, "name": "Fuel Rail Gauge Pressure", "description": "SAE J1979 PID 23, ranging 29 to 197 bar, the right shape for this engine's direct injection rail. It is not the same measurement as the proprietary DID 033E: across 157 paired samples the ratio between them drifts from 0.41 to 0.56 rather than holding constant, and in one stretch this PID sat pinned near 197 bar while 033E climbed from 79 to 110 bar. A fixed scaling error would give a fixed ratio, so these are two different quantities - plausibly a commanded rail target against a measured one. Worth sampling hard under load to separate them."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F401"}, "freq": 600,
  "signals": [
    {"id": "LR4_MONITOR_STATUS", "hidden": true, "path": "ECU", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "Monitor Status Raw", "description": "SAE J1979 PID 01: MIL state, stored DTC count and readiness monitors. Listed as supported by the ECM's own bitmask but never once requested. Top byte is the DTC count with the MIL bit; a non-zero value here is the cheapest possible check for a stored fault."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F441"}, "freq": 600,
  "signals": [
    {"id": "LR4_MONITOR_THIS_CYCLE", "hidden": true, "path": "ECU", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "Monitor Status This Cycle Raw", "description": "SAE J1979 PID 41, readiness monitors for the current drive cycle. Supported per the ECM bitmask, never requested. Changes across a drive as monitors complete, so unlike PID 01 it should not be static."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F413"}, "freq": 600,
  "signals": [
    {"id": "LR4_O2_SENSORS_PRESENT", "hidden": true, "path": "ECU", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "O2 Sensors Present Raw", "description": "SAE J1979 PID 13, a bitmask of which oxygen sensor positions exist. Answered 0x77 on its one logged sample. Static, but it says exactly which O2 PIDs are worth probing."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F451"}, "freq": 600,
  "signals": [
    {"id": "LR4_FUEL_TYPE", "hidden": true, "path": "Fuel", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "Fuel Type Raw", "description": "SAE J1979 PID 51. Supported per the ECM bitmask, never requested. Static, one sample settles it."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F41C"}, "freq": 600,
  "signals": [
    {"id": "LR4_OBD_STANDARD", "hidden": true, "path": "ECU", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "OBD Standard Raw", "description": "SAE J1979 PID 1C, which OBD standard this ECM claims. Supported per the bitmask, never requested. Static."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F403"}, "freq": 120,
  "signals": [
    {"id": "LR4_FUEL_SYS_B1", "path": "Fuel", "fmt": { "len": 8, "max": 255, "map": { "1": { "description": "Open loop, engine cold", "value": "OpenLoopCold" }, "2": { "description": "Closed loop", "value": "ClosedLoop" }, "4": { "description": "Open loop, load or decel fuel cut", "value": "OpenLoopLoad" }, "8": { "description": "Open loop, system fault", "value": "OpenLoopFault" }, "16": { "description": "Closed loop with a feedback fault", "value": "ClosedLoopFault" } } }, "name": "Fuel System Status B1"},
    {"id": "LR4_FUEL_SYS_B2", "path": "Fuel", "fmt": { "bix": 8, "len": 8, "max": 255, "unit": "scalar" }, "name": "Fuel System Status B2", "description": "Bank 2 fuel system status. Has mirrored bank 1 on every sample so far."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F438"}, "freq": 60,
  "signals": [
    {"id": "LR4_O2_LAMBDA_B2", "path": "Engine", "fmt": { "len": 16, "max": 1.999, "div": 32768, "unit": "scalar" }, "name": "O2 Lambda B2S1", "description": "Bank 2 sensor 1. Rails at FFFF on roughly half of samples; treat those as invalid rather than lean."},
    {"id": "LR4_O2_CURRENT_B2", "path": "Engine", "fmt": { "bix": 16, "len": 16, "max": 128, "min": -128, "div": 256, "add": -128, "unit": "milliamps" }, "name": "O2 Pump Current B2S1", "description": "Bank 2 counterpart. See O2 Pump Current B1S1 - PID 38 reports current, not voltage."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F42E"}, "freq": 120,
  "signals": [
    {"id": "LR4_EVAP_PURGE", "path": "Fuel", "fmt": { "len": 8, "max": 100, "mul": 100, "div": 255, "unit": "percent" }, "name": "Commanded Evap Purge"}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F415"}, "freq": 120,
