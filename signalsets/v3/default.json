  ]},
{ "hdr": "795", "rax": "79D", "cmd": {"22": "1E88"}, "freq": 60,
  "signals": [
    {"id": "LR4_1E88_RAW", "hidden": true, "path": "Drivetrain", "fmt": { "len": 16, "max": 65535, "unit": "scalar" }, "name": "1E88 Raw", "description": "Undecoded rear differential DID. Flat at 0000 on every sample so far; a lock cycle is the test."}
  ]},
{ "hdr": "795", "rax": "79D", "cmd": {"22": "1E89"}, "freq": 60,
  "signals": [
    {"id": "LR4_1E89_RAW", "hidden": true, "path": "Drivetrain", "fmt": { "len": 16, "max": 65535, "unit": "scalar" }, "name": "1E89 Raw", "description": "Undecoded rear differential DID. Flat at 09C4 on every sample so far."}
  ]},
{ "hdr": "792", "rax": "79A", "cmd": {"22": "2A32"}, "freq": 120,
  "signals": [
    {"id": "LR4_2A32_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "2A32 Raw", "description": "A counter, not a constant. Held 404720 across 19 samples taken over a single morning and was written off; nine hours and 111 km later it read 420200. 2A32 through 2A37 all advance. What they count is unknown - 2A32 gained 126 per km, 2A33 4.3, 2A34 8.6, 2A35 19.5, 2A36 0.8, 2A37 0.009 - and pinning it needs several samples within one drive, which is why these now poll at 120s."}
  ]},
{ "hdr": "792", "rax": "79A", "cmd": {"22": "2A33"}, "freq": 120,
  "signals": [
    {"id": "LR4_2A33_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "2A33 Raw"}
  ]},
