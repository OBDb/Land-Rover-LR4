    {"id": "LR4_FUEL_DIVISOR", "hidden": true, "path": "Engine", "fmt": { "len": 16, "max": 23.031, "div": 2845.54, "unit": "scalar" }, "name": "Fuel Rate Divisor (gal/h)", "description": "Commanded lambda premultiplied by 14.7 x 745 / 3600 x 3.785 so that mass air flow divided by this value is US gallons per hour. Exists only because synthetic signals support a plain ratio with no constant; it is the constant, folded into the divisor."},
