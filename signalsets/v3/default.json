{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F466"}, "freq": 60,
  "signals": [
    {"id": "LR4_MAF_A", "path": "Engine", "fmt": { "bix": 8, "len": 16, "max": 2047.96, "div": 32, "unit": "gramsPerSecond" }, "name": "Mass Air Flow A", "description": "One of two intake tract sensors. Across 1,474 samples A and B sum to 0.88 of the single MAF PID by least squares, but the scatter between individual pairs is large enough that the split between the two is not trustworthy at this polling rate. Use the single MAF PID for anything quantitative."},
    {"id": "LR4_MAF_B", "path": "Engine", "fmt": { "bix": 24, "len": 16, "max": 2047.96, "div": 32, "unit": "gramsPerSecond" }, "name": "Mass Air Flow B", "description": "One of two intake tract sensors. See Mass Air Flow A."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F467"}, "freq": 60,
  "signals": [
    {"id": "LR4_CAC_COOLANT_TEMP", "path": "Engine", "fmt": { "bix": 16, "len": 8, "max": 215, "min": -40, "add": -40, "unit": "celsius" }, "name": "Charge Cooler Coolant Temp", "description": "The AJ126 runs a separate low-temperature circuit for the supercharger intercooler. Over 135 paired samples this sat 11.7 C above ambient and 24 C below charge air temperature, which is where that circuit belongs. Sensor 1 of the same PID was dropped: it matched the engine coolant PID to 0.0 C."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F468"}, "freq": 120,
  "signals": [
    {"id": "LR4_IAT_1", "path": "Engine", "fmt": { "bix": 8, "len": 8, "max": 215, "min": -40, "add": -40, "unit": "celsius" }, "name": "Intake Air Temp Sensor 1", "description": "Pre-supercharger inlet air, measured 9.2 C above ambient over 135 samples."},
    {"id": "LR4_IAT_2", "path": "Engine", "fmt": { "bix": 16, "len": 8, "max": 215, "min": -40, "add": -40, "unit": "celsius" }, "name": "Intake Air Temp Sensor 2", "description": "Post-supercharger charge air. Tracks the proprietary charge air temperature DID to within 2.7 C on average, so it is close to redundant with it."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "F470"}, "freq": 120,
  "signals": [
    {"id": "LR4_BOOST_A", "path": "Engine", "fmt": { "bix": 24, "len": 16, "max": 2047.96875, "div": 32, "unit": "kilopascal" }, "name": "Manifold Pressure (Fine)", "description": "SAE J1979 PID 70 channel A. Over 525 samples it tracks the 1 kPa manifold pressure PID to within 1.3 kPa on average, so it is the same measurement at 1/32 kPa resolution, not a separate pre-throttle sensor. The other three channels the PID defines read a constant zero and have been removed."}
  ]},
