{ "commands": [
{ "hdr": "732", "cmd": {"22": "D928"}, "freq": 10,
  "signals": [
    {"id": "LR4_GEAR_SELECTOR", "path": "Transmission", "name": "Gear Selector", "fmt": {"len": 8, "map": {
          "0": { "description": "Park",    "value": "Park" },
          "1": { "description": "Reverse", "value": "Reverse" },
          "2": { "description": "Neutral", "value": "Neutral" },
          "3": { "description": "Drive",   "value": "Drive" },
          "7": { "description": "Sport",   "value": "Sport" }
        }}
    }
  ]},
{ "hdr": "761", "rax": "769", "cmd": {"22": "197C"}, "freq": 120,
  "signals": [
    {"id": "LR4_197C_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 16, "max": 65535, "unit": "scalar" }, "name": "197C Raw", "description": "Undecoded. Nine distinct values in fourteen samples, the most variable unmined DID on the truck."}
  ]},
{ "hdr": "761", "rax": "769", "cmd": {"22": "D11C"}, "freq": 120,
  "signals": [
    {"id": "LR4_D11C_RAW", "hidden": true, "path": "ECU", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "D11C Raw", "description": "Undecoded. Ranges 0x3A to 0x41, which would be a plausible temperature."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B01"}, "freq": 15,
  "signals": [
    {"id": "LR4_RIDE_HEIGHT_STATE", "path": "Suspension", "name": "Ride Height State", "description": "Runs in parallel with the ride height mode PID and agrees with it. All three observed bits are measured against the front height sensor: 0x100 at a front reading around 110 (Normal), 0x400 around 85 with the truck at its highest (Off-Road), 0x800 at 133 with it at its lowest (Access). Remember the sensor is inverted. Bit 9 (0x200) sits between Normal and Off-Road and has never been seen in 142 samples; the held-Access mode, where the lower button is held and the truck stays down, is the obvious candidate and has never been captured.", "fmt": {"len": 32, "map": {
          "256":  { "description": "Normal",   "value": "Normal" },
          "1024": { "description": "Off-Road", "value": "Off-Road" },
          "2048": { "description": "Access",   "value": "Access" }
        }}
    },
    {"id": "LR4_RIDE_HEIGHT_STATE_RAW", "path": "Suspension", "fmt": { "len": 32, "max": 4294967295, "unit": "scalar" }, "name": "Ride Height State Raw", "description": "Untranslated twin of Ride Height State. A mapped signal renders nothing for a value it has not been taught, so an unmapped state would be invisible in the app and only recoverable from the scan logs. This costs no extra request and makes a new state show up as a number."}
  ]},
{ "hdr": "7E1", "rax": "7E9", "cmd": {"22": "DD01"}, "freq": 600,
  "signals": [
    {"id": "LR4_DD01_RAW", "hidden": true, "path": "Drivetrain", "fmt": { "len": 24, "max": 16777215, "unit": "scalar" }, "name": "DD01 Raw"}
  ]},
{ "hdr": "795", "cmd": {"22": "1E8A"}, "freq": 30,
  "signals": [
    {"id": "LR4_REAR_DIFF_TEMP", "path": "Drivetrain", "fmt": { "len": 8, "max": 150, "min": -40, "add": -40, "unit": "celsius" }, "name": "Locking Diff Oil Temp"}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "2B12"}, "freq": 60,
