  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B04"}, "freq": 30,
  "signals": [
    {"id": "LR4_SUSPENSION_PRES_FL", "path": "Suspension", "fmt": {"bix": 8, "len": 8, "max": 51, "div": 5, "nullmin": 0, "unit": "psi" }, "name": "Suspension Pressure Front Left"}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B05"}, "freq": 30,
  "signals": [
