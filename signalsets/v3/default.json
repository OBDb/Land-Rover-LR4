{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B07"}, "freq": 30,
  "signals": [
    {"id": "LR4_SUSPENSION_COMPRESSOR", "path": "Suspension", "fmt": { "len": 16, "max": 65535, "nullmin": 0, "unit": "scalar" }, "name": "Compressor Activity"}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B0B"}, "freq": 60,
  "signals": [
    {"id": "LR4_3B0B_RAW", "hidden": true, "path": "Suspension", "fmt": { "len": 16, "max": 65535, "nullmin": 0, "unit": "scalar" }, "name": "3B0B Raw", "description": "Undecoded suspension DID, narrow range around 0x3D5."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B3C"}, "freq": 10,
  "signals": [
    {"id": "LR4_RIDE_HEIGHT", "path": "Suspension", "name": "Ride Height Mode", "description": "A bitfield, not an ordinal: bit 0 Normal, bit 1 Off-Road, bit 2 Access. 0x0D is 0x01|0x04|0x08 and has only been seen with the truck part-way between Normal and Access, so bit 3 reads as movement rather than a mode of its own. Bit 3 has never been seen set on its own, which is where a held-Access mode would most likely appear.", "fmt": {"len": 8, "map": {
          "1":  { "description": "Normal",     "value": "Normal" },
          "2":  { "description": "Off-Road",   "value": "Off-Road" },
          "4":  { "description": "Access",     "value": "Access" },
          "13": { "description": "In Transit", "value": "In Transit" }
        }}
    },
    {"id": "LR4_RIDE_HEIGHT_RAW", "path": "Suspension", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "Ride Height Mode Raw", "description": "Untranslated twin of Ride Height Mode, for the same reason as the state word: an unmapped value renders as a blank, and a blank teaches nothing."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B71"}, "freq": 15,
  "signals": [
    {"id": "LR4_RIDE_HEIGHT_FRONT", "path": "Suspension", "fmt": { "len": 8, "max": 255, "nullmin": 0, "unit": "scalar" }, "name": "Height Sensor Front (inverted)", "description": "Inverted: a falling value means the truck is rising."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "3B72"}, "freq": 15,
  "signals": [
    {"id": "LR4_RIDE_HEIGHT_REAR", "path": "Suspension", "fmt": { "len": 8, "max": 255, "nullmin": 0, "unit": "scalar" }, "name": "Height Sensor Rear (inverted)", "description": "Inverted: a falling value means the truck is rising."}
  ]},
{ "hdr": "7D3", "rax": "7DB", "cmd": {"22": "D11A"}, "freq": 60,
  "signals": [
    {"id": "LR4_D11A_RAW", "path": "Suspension", "fmt": { "len": 8, "max": 255, "unit": "scalar" }, "name": "D11A Raw", "description": "Was called Suspension Module Voltage and scaled to volts. It is not battery voltage: across 221 paired samples its raw range spans 57 to 105, an 84% swing, while control module voltage moved only 12.51 to 14.75, an 18% swing, and the implied scale scatters by 9%. The old scaling also put it at 16.8 V, which no 12 V system reaches. Best correlation found so far is 0.58 against compressor activity, which is not enough to name it. Undecoded until something fits."}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "033E"}, "freq": 30,
  "signals": [
    {"id": "LR4_FUEL_RAIL_P", "path": "Fuel", "fmt": { "len": 16, "max": 30000, "unit": "kilopascal" }, "name": "Fuel Rail Pressure"}
  ]},
{ "hdr": "7E0", "rax": "7E8", "cmd": {"22": "03E6"}, "freq": 600,
  "signals": [
    {"id": "LR4_MEASURED_OIL_LEVEL", "path": "Engine", "fmt": { "len": 8, "max": 255, "unit": "millimeters" }, "name": "Oil Level"}
